{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ecs",
      "camelcase": "Ecs",
      "title": "Ecs",
      "scope": "source.ecs",
      "file-types": [
        "ecs"
      ],
      "injection-regex": "^ecs$",
      "class-name": "TreeSitterEcs"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Ecs grammar for tree-sitter",
    "authors": [
      {
        "name": "Jan Kleinmann",
        "email": "jan.kleinmann@proton.me",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-ecs",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": true
  }
}