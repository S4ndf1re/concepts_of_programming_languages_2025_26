
system update_position(positions: P)
    querying P as List with { Position2d }
{
    for (p in positions) {
        pos := p[0];

        pos.x = (pos.x + 1.0) % 640.0;
        pos.y = (pos.y - 1.0 + 480.0) % 480.0;
    }
}

register update_position;


fn main() {
    raylib_init();

    create entity rect;

    rect += Position2d {
        x: 0.0,
        y: 0.0,
    };
    rect += RectangleShape {
        w: 100.0,
        h: 100.0,
    };
    rect += Colorable {
        r: 255,
        g: 0,
        b: 0,
    };
}
